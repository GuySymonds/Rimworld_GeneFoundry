<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">

    <defName>GF_BiomassRefinery</defName>
    <label>biomass refinery</label>

    <description>An automated biotechnology facility that purifies raw biomass into concentrated genetic material.

Refinement requires substantial electrical power but operates without direct colonist supervision.</description>

    <thingClass>Building_WorkTable</thingClass>
    <tickerType>Normal</tickerType>
    <category>Building</category>

    <!-- Temporary artwork -->
    <graphicData>
      <texPath>Things/Building/Production/TableDrugLab</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3.5,1.5)</drawSize>
    </graphicData>

    <size>(3,1)</size>

    <costList>
      <Steel>200</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
    </costList>

    <statBases>
      <WorkToBuild>4500</WorkToBuild>
      <MaxHitPoints>250</MaxHitPoints>
      <Flammability>0.4</Flammability>
    </statBases>

    <useHitPoints>true</useHitPoints>

    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>

    <designationCategory>Production</designationCategory>

    <!-- Colonist interaction -->
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>

    <!-- Production bills -->
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>

    <!-- Available production recipes -->
    <recipes>
      <li>GF_StartBiomassRefinement</li>
    </recipes>

    <!-- Electrical components -->
    <comps>

      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>100</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>

      <li Class="CompProperties_Flickable" />

      <li Class="CompProperties_Breakdownable" />

      <!-- Automated biomass refinement -->
      <li Class="GeneFoundry.Components.CompProperties_BiomassRefiner">

        <inputDef>GF_RawBiomass</inputDef>
        <outputDef>GF_RefinedBiomass</outputDef>

        <inputCount>10</inputCount>
        <outputCount>2</outputCount>

        <processingTicks>2500</processingTicks>

        <idlePower>100</idlePower>
        <activePower>1500</activePower>

      </li>

    </comps>

  </ThingDef>

</Defs>