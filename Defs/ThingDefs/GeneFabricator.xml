<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BenchBase">

    <defName>GF_GeneFabricator</defName>
    <label>gene fabricator</label>

    <description>A sophisticated genetic engineering workstation used to manufacture custom genepacks from refined biomass.</description>

    <thingClass>Building_WorkTable</thingClass>

    <!-- Gene Fabricator artwork -->
    <graphicData>
      <texPath>GeneFoundry/Buildings/GeneFabrication_north</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(5,2)</drawSize>
      <drawRotated>false</drawRotated>
    </graphicData>

    <!-- Building dimensions -->
    <size>(5,2)</size>
    <rotatable>false</rotatable>

    <!-- Research -->
    <researchPrerequisites>
      <li>GF_GeneFabrication</li>
    </researchPrerequisites>

    <!-- Construction -->
    <costList>
      <Steel>250</Steel>
      <ComponentIndustrial>8</ComponentIndustrial>
    </costList>

    <statBases>
      <WorkToBuild>5000</WorkToBuild>
      <MaxHitPoints>250</MaxHitPoints>
      <Flammability>0.4</Flammability>
    </statBases>

    <useHitPoints>true</useHitPoints>

    <!-- Placement -->
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>

    <designationCategory>Biotech</designationCategory>

    <!-- Colonist interaction -->
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>

    <surfaceType>Item</surfaceType>

    <building>
      <workTableRoomRole>Laboratory</workTableRoomRole>
    </building>

  </ThingDef>

</Defs>