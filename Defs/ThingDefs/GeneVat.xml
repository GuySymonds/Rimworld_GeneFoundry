<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BenchBase">

    <defName>GF_GeneVat</defName>
    <label>gene vat</label>

    <description>A biological processing workstation used to extract raw genetic biomass from organic materials.

Colonists manually process biological matter, optionally using herbal medicine to improve extraction efficiency.</description>

    <thingClass>Building_WorkTable</thingClass>

    <!-- Temporary vanilla artwork -->
    <graphicData>
      <texPath>GeneFoundry/Buildings/GeneVat</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,3.6)</drawSize>
      <drawRotated>false</drawRotated>
    </graphicData>

    <!-- Construction -->
    <size>(3,3)</size>
    <rotatable>false</rotatable>

    <costList>
      <Steel>150</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>

    <statBases>
      <WorkToBuild>3000</WorkToBuild>
      <MaxHitPoints>220</MaxHitPoints>
      <Flammability>0.5</Flammability>
    </statBases>

    <useHitPoints>true</useHitPoints>

    <!-- Placement -->
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>

    <designationCategory>Production</designationCategory>

    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-2)</interactionCellOffset>
    <surfaceType>Item</surfaceType>

    <!-- Available recipes -->
    <recipes>
      <li>GF_ExtractBiomassBasic</li>
      <li>GF_ExtractBiomassEnzymatic</li>
    </recipes>

    <!-- Bills interface -->
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>

    <!-- Electrical components -->
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>250</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>

      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
    </comps>

    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
      <workTableRoomRole>Laboratory</workTableRoomRole>
    </building>

  </ThingDef>

</Defs>