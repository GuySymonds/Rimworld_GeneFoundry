<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">

    <defName>GF_BiomassHopper</defName>
    <label>raw biomass hopper</label>

    <description>A specialised storage hopper that supplies raw biomass to an adjacent biomass refinery.

Colonists automatically deliver raw biomass to the hopper. The connected refinery consumes the material during automated processing.</description>

    <thingClass>Building_Storage</thingClass>

    <!-- GeneFoundry Raw Biomass Hopper artwork -->
    <graphicData>
      <texPath>GeneFoundry/Buildings/BiomassHopper</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(1.2,1.2)</drawSize>
      <drawRotated>false</drawRotated>
    </graphicData>
    
    <size>(1,1)</size>
    <rotatable>true</rotatable>

    <placeWorkers>
      <li>GeneFoundry.PlaceWorkers.PlaceWorker_BiomassHopper</li>
    </placeWorkers>

    <!-- Construction -->
    <costList>
      <Steel>30</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>

    <statBases>
      <WorkToBuild>500</WorkToBuild>
      <MaxHitPoints>120</MaxHitPoints>
      <Flammability>0.5</Flammability>
    </statBases>

    <useHitPoints>true</useHitPoints>

    <!-- Placement -->
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>42</pathCost>
    <fillPercent>0.5</fillPercent>

    <designationCategory>Biotech</designationCategory>
    <surfaceType>Item</surfaceType>

    <!-- Storage configuration -->
    <building>

      <blueprintClass>Blueprint_Storage</blueprintClass>

      <fixedStorageSettings>
        <priority>Important</priority>
        <filter>
          <thingDefs>
            <li>GF_RawBiomass</li>
          </thingDefs>
        </filter>
      </fixedStorageSettings>

      <defaultStorageSettings>
        <priority>Important</priority>
        <filter>
          <thingDefs>
            <li>GF_RawBiomass</li>
          </thingDefs>
        </filter>
      </defaultStorageSettings>

    </building>

    <inspectorTabs>
      <li>ITab_Storage</li>
    </inspectorTabs>

    <tickerType>Never</tickerType>

  </ThingDef>

</Defs>