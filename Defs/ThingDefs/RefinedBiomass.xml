<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ResourceBase">

    <defName>GF_RefinedBiomass</defName>
    <label>refined biomass</label>

    <description>Highly purified genetic material produced through the energy-intensive refinement of raw biomass.

Contains concentrated biological compounds suitable for manufacturing synthetic genes.</description>

    <graphicData>
      <texPath>GeneFoundry/RefinedBiomass</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>

    <stackLimit>25</stackLimit>
    <useHitPoints>true</useHitPoints>

    <statBases>
      <MarketValue>6</MarketValue>
      <Mass>0.1</Mass>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>0.4</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>

    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>

  </ThingDef>
</Defs>