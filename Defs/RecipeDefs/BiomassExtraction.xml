<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- BASIC EXTRACTION -->
  <RecipeDef>

    <defName>GF_ExtractBiomassBasic</defName>
    <label>extract raw biomass</label>

    <description>Process raw meat to extract usable biological material, producing raw genetic biomass.</description>

    <jobString>Extracting raw biomass.</jobString>

    <workAmount>1000</workAmount>
    <workSpeedStat>GF_BiomassExtractionSpeed</workSpeedStat>
    <workSkill>Cooking</workSkill>
    <workSkillLearnFactor>0</workSkillLearnFactor>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>

    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>

    <allowMixingIngredients>true</allowMixingIngredients>

    <ingredients>
      <li>
        <filter>
          <categories>
            <li>MeatRaw</li>
          </categories>
        </filter>
        <count>50</count>
      </li>
    </ingredients>

    <fixedIngredientFilter>
      <categories>
        <li>MeatRaw</li>
      </categories>
    </fixedIngredientFilter>

    <products>
      <GF_RawBiomass>25</GF_RawBiomass>
    </products>

  </RecipeDef>


  <!-- ENZYMATIC EXTRACTION -->
  <RecipeDef>

    <defName>GF_ExtractBiomassEnzymatic</defName>
    <label>extract biomass (enzymatic)</label>

    <description>Process raw meat using herbal medicine as a biological extraction catalyst.

This process recovers additional genetic biomass.</description>

    <jobString>Extracting biomass using enzymes.</jobString>

    <workAmount>1000</workAmount>
    <workSpeedStat>GF_BiomassExtractionSpeed</workSpeedStat>
    <workSkill>Cooking</workSkill>
    <workSkillLearnFactor>0</workSkillLearnFactor>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>

    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>

    <allowMixingIngredients>true</allowMixingIngredients>

    <ingredients>

      <!-- Organic material -->
      <li>
        <filter>
          <categories>
            <li>MeatRaw</li>
          </categories>
        </filter>
        <count>50</count>
      </li>

      <!-- Extraction catalyst -->
      <li>
        <filter>
          <thingDefs>
            <li>MedicineHerbal</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>

    </ingredients>

    <fixedIngredientFilter>
      <categories>
        <li>MeatRaw</li>
      </categories>
      <thingDefs>
        <li>MedicineHerbal</li>
      </thingDefs>
    </fixedIngredientFilter>

    <products>
      <GF_RawBiomass>38</GF_RawBiomass>
    </products>

  </RecipeDef>

  <!-- PLANT EXTRACTION -->
  <RecipeDef>

    <defName>GF_ExtractBiomassPlant</defName>
    <label>extract biomass from raw plants</label>
    <description>Process 50 raw plant food into 10 raw biomass. Plant material provides less biomass than the same quantity of raw meat. Different raw plant foods may be mixed within a batch; the bill's ingredient filter controls which foods may be used.</description>
    <jobString>Extracting biomass from plant material.</jobString>

    <workAmount>1000</workAmount>
    <workSpeedStat>GF_BiomassExtractionSpeed</workSpeedStat>
    <workSkill>Cooking</workSkill>
    <workSkillLearnFactor>0</workSkillLearnFactor>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>

    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>

    <ingredients>
      <li>
        <filter>
          <categories>
            <li>PlantFoodRaw</li>
          </categories>
        </filter>
        <count>50</count>
      </li>
    </ingredients>

    <fixedIngredientFilter>
      <categories>
        <li>PlantFoodRaw</li>
      </categories>
    </fixedIngredientFilter>

    <products>
      <GF_RawBiomass>10</GF_RawBiomass>
    </products>

  </RecipeDef>

</Defs>
