<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- BASIC EXTRACTION -->
  <RecipeDef>

    <defName>GF_ExtractBiomassBasic</defName>
    <researchPrerequisite>GF_BiomassExtraction</researchPrerequisite>
    <label>extract raw biomass from meat</label>

    <description>Process 50 raw meat into a base yield of 25 raw biomass. Skills above level 10 improve recovery according to the expert yield setting.</description>

    <jobString>Extracting raw biomass from meat.</jobString>

    <skillRequirements>
      <Cooking>3</Cooking>
    </skillRequirements>

    <workAmount>1000</workAmount>
    <workSpeedStat>GF_BiomassExtractionSpeed</workSpeedStat>
    <efficiencyStat>GF_BiomassExtractionYield</efficiencyStat>
    <workSkill>Cooking</workSkill>
    <workSkillLearnFactor>0</workSkillLearnFactor>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>

    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>

    <allowMixingIngredients>true</allowMixingIngredients>

    <ingredients>
      <li>
        <filter>
          <categories>
            <li>MeatRaw</li>
          </categories>
        </filter>
        <count>50</count>
      </li>
    </ingredients>

    <fixedIngredientFilter>
      <categories>
        <li>MeatRaw</li>
      </categories>
    </fixedIngredientFilter>

    <products>
      <GF_RawBiomass>25</GF_RawBiomass>
    </products>

  </RecipeDef>


  <!-- ENZYMATIC EXTRACTION -->
  <RecipeDef>

    <defName>GF_ExtractBiomassEnzymatic</defName>
    <researchPrerequisite>GF_EnzymaticExtraction</researchPrerequisite>
    <label>extract raw biomass from meat (enzymatic)</label>

    <description>Process raw meat using herbal medicine as a biological extraction catalyst.

The base yield is 38 raw biomass from 50 raw meat and 1 herbal medicine. Skills above level 10 further improve recovery according to the expert yield setting.</description>

    <jobString>Extracting raw biomass from meat using enzymes.</jobString>

    <skillRequirements>
      <Cooking>3</Cooking>
      <Medicine>3</Medicine>
      <Intellectual>2</Intellectual>
    </skillRequirements>

    <workAmount>1000</workAmount>
    <workSpeedStat>GF_BiomassExtractionSpeed</workSpeedStat>
    <efficiencyStat>GF_BiomassExtractionYield</efficiencyStat>
    <workSkill>Cooking</workSkill>
    <workSkillLearnFactor>0</workSkillLearnFactor>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>

    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>

    <allowMixingIngredients>true</allowMixingIngredients>

    <ingredients>

      <!-- Organic material -->
      <li>
        <filter>
          <categories>
            <li>MeatRaw</li>
          </categories>
        </filter>
        <count>50</count>
      </li>

      <!-- Extraction catalyst -->
      <li>
        <filter>
          <thingDefs>
            <li>MedicineHerbal</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>

    </ingredients>

    <fixedIngredientFilter>
      <categories>
        <li>MeatRaw</li>
      </categories>
      <thingDefs>
        <li>MedicineHerbal</li>
      </thingDefs>
    </fixedIngredientFilter>

    <products>
      <GF_RawBiomass>38</GF_RawBiomass>
    </products>

  </RecipeDef>

  <!-- PLANT EXTRACTION -->
  <RecipeDef>

    <defName>GF_ExtractBiomassPlant</defName>
    <researchPrerequisite>GF_BiomassExtraction</researchPrerequisite>
    <label>extract raw biomass from plants</label>
    <description>Process 50 raw plant food into a base yield of 10 raw biomass. Skills above level 10 improve recovery according to the expert yield setting. Plant material provides less biomass than the same quantity of raw meat. Different raw plant foods may be mixed within a batch; the bill's ingredient filter controls which foods may be used.</description>
    <jobString>Extracting raw biomass from plants.</jobString>

    <skillRequirements>
      <Cooking>3</Cooking>
    </skillRequirements>

    <workAmount>1000</workAmount>
    <workSpeedStat>GF_BiomassExtractionSpeed</workSpeedStat>
    <efficiencyStat>GF_BiomassExtractionYield</efficiencyStat>
    <workSkill>Cooking</workSkill>
    <workSkillLearnFactor>0</workSkillLearnFactor>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>

    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>

    <ingredients>
      <li>
        <filter>
          <categories>
            <li>PlantFoodRaw</li>
          </categories>
        </filter>
        <count>50</count>
      </li>
    </ingredients>

    <fixedIngredientFilter>
      <categories>
        <li>PlantFoodRaw</li>
      </categories>
    </fixedIngredientFilter>

    <products>
      <GF_RawBiomass>10</GF_RawBiomass>
    </products>

  </RecipeDef>

  <RecipeDef>
    <defName>GF_ExtractBiomassPlantEnzymatic</defName>
    <researchPrerequisite>GF_EnzymaticExtraction</researchPrerequisite>
    <label>extract raw biomass from plants (enzymatic)</label>
    <description>Process 50 raw plant food and 1 herbal medicine into a base yield of 15 raw biomass, 50% more than basic plant extraction. Different raw plant foods can be mixed within a batch. Expert recovery bonuses apply afterward. Requires Cooking 3, Medicine 3 and Intellectual 2.</description>
    <jobString>Extracting raw biomass from plants using enzymes.</jobString>
    <skillRequirements>
      <Cooking>3</Cooking>
      <Medicine>3</Medicine>
      <Intellectual>2</Intellectual>
    </skillRequirements>
    <workAmount>1000</workAmount>
    <workSpeedStat>GF_BiomassExtractionSpeed</workSpeedStat>
    <efficiencyStat>GF_BiomassExtractionYield</efficiencyStat>
    <workSkill>Cooking</workSkill>
    <workSkillLearnFactor>0</workSkillLearnFactor>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>PlantFoodRaw</li>
          </categories>
        </filter>
        <count>50</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MedicineHerbal</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>PlantFoodRaw</li>
      </categories>
      <thingDefs>
        <li>MedicineHerbal</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <GF_RawBiomass>15</GF_RawBiomass>
    </products>
  </RecipeDef>
</Defs>
