<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <SpecialThingFilterDef>
    <defName>GF_AllowUnsafeBiomassCorpses</defName>
    <label>corpses unsuitable for biomass extraction</label>
    <description>Non-organic corpses unsuitable for biomass extraction.</description>
    <parentCategory>Corpses</parentCategory>
    <allowedByDefault>true</allowedByDefault>
    <saveKey>gfAllowUnsafeBiomassCorpses</saveKey>
    <workerClass>GeneFoundry.Recipes.SpecialThingFilterWorker_UnsafeBiomassCorpse</workerClass>
  </SpecialThingFilterDef>
  <RecipeDef>
    <defName>GF_ExtractBiomassCorpse</defName>
    <researchPrerequisite>GF_BiomassExtraction</researchPrerequisite>
    <label>extract raw biomass from corpse (variable yield)</label>
    <workerCounterClass>GeneFoundry.Recipes.RecipeWorkerCounter_CorpseBiomass</workerCounterClass>
    <uiIconThing>GF_RawBiomass</uiIconThing>
    <description>Extract raw biomass from recoverable corpse material, respecting missing parts. Whole bodies provide 10% more material than butchered meat. Basic extraction recovers 40%; enzymatic extraction recovers 50% with 1 herbal medicine per 50 original material, rounded up (minimum 1), consumed at completion. Fresh/rotting/desiccated recovery is 100%/50%/10%. Operator wastage is applied afterward, with at least one biomass. Reference Cooking/Medicine/Intellectual levels are 10/6/4; higher skills improve speed only. Active extraction can release rot stink when any skill is below 10. Stripping and artificial-part salvage are preserved.</description>
    <jobString>Extracting raw biomass from a corpse.</jobString>
    <skillRequirements>
      <Cooking>3</Cooking>
      <Medicine>3</Medicine>
      <Intellectual>2</Intellectual>
    </skillRequirements>
    <workAmount>500</workAmount>
    <workSpeedStat>GF_BiomassExtractionSpeed</workSpeedStat>
    <workSkill>Cooking</workSkill>
    <workSkillLearnFactor>0</workSkillLearnFactor>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>
    <interruptIfIngredientIsRotting>false</interruptIfIngredientIsRotting>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Corpses</li>
          </categories>
          <disallowedCategories>
            <li>CorpsesMechanoid</li>
            <li MayRequire="Ludeon.RimWorld.Odyssey">CorpsesDrone</li>
          </disallowedCategories>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>Corpses</li>
      </categories>
      <disallowedCategories>
        <li>CorpsesMechanoid</li>
        <li MayRequire="Ludeon.RimWorld.Odyssey">CorpsesDrone</li>
      </disallowedCategories>
      <specialFiltersToDisallow>
        <li>GF_AllowUnsafeBiomassCorpses</li>
      </specialFiltersToDisallow>
    </fixedIngredientFilter>
    <defaultIngredientFilter>
      <categories>
        <li>CorpsesAnimal</li>
      </categories>
      <specialFiltersToAllow>
        <li>AllowFresh</li>
        <li>AllowRotten</li>
      </specialFiltersToAllow>
    </defaultIngredientFilter>
    <forceHiddenSpecialFilters>
      <li>GF_AllowUnsafeBiomassCorpses</li>
    </forceHiddenSpecialFilters>
    <!-- Variable output uses the custom counter, not a misleading fixed product quantity. -->
  </RecipeDef>
  <RecipeDef>
    <defName>GF_ExtractBiomassCorpseEnzymatic</defName>
    <researchPrerequisite>GF_EnzymaticExtraction</researchPrerequisite>
    <label>extract raw biomass from corpse (enzymatic, variable yield)</label>
    <description>Extract raw biomass from recoverable corpse material, respecting missing parts. Whole bodies provide 10% more material than butchered meat. Basic extraction recovers 40%; enzymatic extraction recovers 50% with 1 herbal medicine per 50 original material, rounded up (minimum 1), consumed at completion. Fresh/rotting/desiccated recovery is 100%/50%/10%. Operator wastage is applied afterward, with at least one biomass. Reference Cooking/Medicine/Intellectual levels are 10/6/4; higher skills improve speed only. Active extraction can release rot stink when any skill is below 10. Stripping and artificial-part salvage are preserved.</description>
    <workerCounterClass>GeneFoundry.Recipes.RecipeWorkerCounter_CorpseBiomass</workerCounterClass>
    <uiIconThing>GF_RawBiomass</uiIconThing>
    <jobString>Extracting raw biomass from a corpse using enzymes.</jobString>
    <skillRequirements>
      <Cooking>3</Cooking>
      <Medicine>3</Medicine>
      <Intellectual>2</Intellectual>
    </skillRequirements>
    <workAmount>500</workAmount>
    <workSpeedStat>GF_BiomassExtractionSpeed</workSpeedStat>
    <workSkill>Cooking</workSkill>
    <workSkillLearnFactor>0</workSkillLearnFactor>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>
    <interruptIfIngredientIsRotting>false</interruptIfIngredientIsRotting>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Corpses</li>
          </categories>
          <disallowedCategories>
            <li>CorpsesMechanoid</li>
            <li MayRequire="Ludeon.RimWorld.Odyssey">CorpsesDrone</li>
          </disallowedCategories>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MedicineHerbal</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>Corpses</li>
      </categories>
      <thingDefs>
        <li>MedicineHerbal</li>
      </thingDefs>
      <disallowedCategories>
        <li>CorpsesMechanoid</li>
        <li MayRequire="Ludeon.RimWorld.Odyssey">CorpsesDrone</li>
      </disallowedCategories>
      <specialFiltersToDisallow>
        <li>GF_AllowUnsafeBiomassCorpses</li>
      </specialFiltersToDisallow>
    </fixedIngredientFilter>
    <defaultIngredientFilter>
      <categories>
        <li>CorpsesAnimal</li>
      </categories>
      <thingDefs>
        <li>MedicineHerbal</li>
      </thingDefs>
      <specialFiltersToAllow>
        <li>AllowFresh</li>
        <li>AllowRotten</li>
      </specialFiltersToAllow>
    </defaultIngredientFilter>
    <forceHiddenSpecialFilters>
      <li>GF_AllowUnsafeBiomassCorpses</li>
    </forceHiddenSpecialFilters>
  </RecipeDef>
</Defs>
