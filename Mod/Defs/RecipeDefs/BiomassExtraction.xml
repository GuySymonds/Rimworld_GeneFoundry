<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- BASIC EXTRACTION -->
  <RecipeDef>

    <defName>GF_ExtractBiomassBasic</defName>
    <researchPrerequisite>GF_GeneFabrication</researchPrerequisite>
    <label>extract raw biomass from meat</label>

    <description>50 raw meat yields up to 20 raw biomass. Cooking/Medicine/Intellectual reference levels 10/6/4 give full recovery. Weighted shortfalls cause random wastage, with at least one biomass recovered. Above-reference skills improve speed only. All inputs can release rot stink during active extraction when any of these skills is below 10.</description>

    <jobString>Extracting raw biomass from meat.</jobString>

    <skillRequirements>
      <Cooking>3</Cooking>
    </skillRequirements>

    <workAmount>500</workAmount>
    <workSpeedStat>GF_BiomassExtractionSpeed</workSpeedStat>
    <efficiencyStat>GF_BiomassExtractionYield</efficiencyStat>
    <workSkill>Cooking</workSkill>
    <workSkillLearnFactor>0</workSkillLearnFactor>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>

    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>

    <allowMixingIngredients>true</allowMixingIngredients>

    <ingredients>
      <li>
        <filter>
          <categories>
            <li>MeatRaw</li>
          </categories>
        </filter>
        <count>50</count>
      </li>
    </ingredients>

    <fixedIngredientFilter>
      <categories>
        <li>MeatRaw</li>
      </categories>
    </fixedIngredientFilter>

    <products>
      <GF_RawBiomass>20</GF_RawBiomass>
    </products>

  </RecipeDef>


  <!-- ENZYMATIC EXTRACTION -->
  <RecipeDef>

    <defName>GF_ExtractBiomassEnzymatic</defName>
    <researchPrerequisite>GF_EnzymaticExtraction</researchPrerequisite>
    <label>extract raw biomass from meat (enzymatic)</label>

    <description>50 raw meat and 1 herbal medicine yield up to 25 raw biomass. Cooking/Medicine/Intellectual reference levels 10/6/4 give full recovery. Weighted shortfalls cause random wastage, with at least one biomass recovered. Above-reference skills improve speed only. All inputs can release rot stink during active extraction when any of these skills is below 10.</description>

    <jobString>Extracting raw biomass from meat using enzymes.</jobString>

    <skillRequirements>
      <Cooking>3</Cooking>
      <Medicine>3</Medicine>
      <Intellectual>2</Intellectual>
    </skillRequirements>

    <workAmount>500</workAmount>
    <workSpeedStat>GF_BiomassExtractionSpeed</workSpeedStat>
    <efficiencyStat>GF_BiomassExtractionYield</efficiencyStat>
    <workSkill>Cooking</workSkill>
    <workSkillLearnFactor>0</workSkillLearnFactor>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>

    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>

    <allowMixingIngredients>true</allowMixingIngredients>

    <ingredients>

      <!-- Organic material -->
      <li>
        <filter>
          <categories>
            <li>MeatRaw</li>
          </categories>
        </filter>
        <count>50</count>
      </li>

      <!-- Extraction catalyst -->
      <li>
        <filter>
          <thingDefs>
            <li>MedicineHerbal</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>

    </ingredients>

    <fixedIngredientFilter>
      <categories>
        <li>MeatRaw</li>
      </categories>
      <thingDefs>
        <li>MedicineHerbal</li>
      </thingDefs>
    </fixedIngredientFilter>

    <products>
      <GF_RawBiomass>25</GF_RawBiomass>
    </products>

  </RecipeDef>

