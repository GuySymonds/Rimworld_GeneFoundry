<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- BASIC EXTRACTION -->
  <RecipeDef>

    <defName>GF_ExtractBiomassBasic</defName>
    <researchPrerequisite>GF_GeneFabrication</researchPrerequisite>
    <label>extract raw biomass from meat</label>

    <description>Extract raw biomass from 50 raw meat. Dry mass is 25% of input mass; 60% recovery gives 7 raw biomass before operator wastage, rounded down. Successful extraction yields at least one raw biomass. Existing skill speed, wastage and environmental penalties apply.</description>

    <jobString>Extracting raw biomass from meat.</jobString>

    <skillRequirements>
      <Cooking>3</Cooking>
    </skillRequirements>

    <workAmount>500</workAmount>
    <workSpeedStat>GF_BiomassExtractionSpeed</workSpeedStat>
    <efficiencyStat>GF_BiomassExtractionYield</efficiencyStat>
    <workSkill>Cooking</workSkill>
    <workSkillLearnFactor>0</workSkillLearnFactor>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>

    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>

    <allowMixingIngredients>true</allowMixingIngredients>

    <ingredients>
      <li>
        <filter>
          <categories>
            <li>MeatRaw</li>
          </categories>
        </filter>
        <count>50</count>
      </li>
    </ingredients>

    <fixedIngredientFilter>
      <categories>
        <li>MeatRaw</li>
      </categories>
    </fixedIngredientFilter>

    <products>
      <GF_RawBiomass>7</GF_RawBiomass>
    </products>

  </RecipeDef>


  <!-- ENZYMATIC EXTRACTION -->
  <RecipeDef>

    <defName>GF_ExtractBiomassEnzymatic</defName>
    <researchPrerequisite>GF_EnzymaticExtraction</researchPrerequisite>
    <label>extract raw biomass from meat (enzymatic)</label>

    <description>Extract raw biomass from 50 raw meat and 1 herbal medicine. Dry mass is 25% of input mass; 75% recovery gives 9 raw biomass before operator wastage, rounded down. Successful extraction yields at least one raw biomass. Existing skill speed, wastage and environmental penalties apply.</description>

    <jobString>Extracting raw biomass from meat using enzymes.</jobString>

    <skillRequirements>
      <Cooking>3</Cooking>
      <Medicine>3</Medicine>
      <Intellectual>2</Intellectual>
    </skillRequirements>

    <workAmount>500</workAmount>
    <workSpeedStat>GF_BiomassExtractionSpeed</workSpeedStat>
    <efficiencyStat>GF_BiomassExtractionYield</efficiencyStat>
    <workSkill>Cooking</workSkill>
    <workSkillLearnFactor>0</workSkillLearnFactor>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>

    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>

    <allowMixingIngredients>true</allowMixingIngredients>

    <ingredients>

      <!-- Organic material -->
      <li>
        <filter>
          <categories>
            <li>MeatRaw</li>
          </categories>
        </filter>
        <count>50</count>
      </li>

      <!-- Extraction catalyst -->
      <li>
        <filter>
          <thingDefs>
            <li>MedicineHerbal</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>

    </ingredients>

    <fixedIngredientFilter>
      <categories>
        <li>MeatRaw</li>
      </categories>
      <thingDefs>
        <li>MedicineHerbal</li>
      </thingDefs>
    </fixedIngredientFilter>

    <products>
      <GF_RawBiomass>9</GF_RawBiomass>
    </products>

  </RecipeDef>

