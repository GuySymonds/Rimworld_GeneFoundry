<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">

    <defName>GF_BiomassHopper</defName>
    <researchPrerequisites>
      <li>GF_BiomassRefinement</li>
    </researchPrerequisites>
    <label>raw biomass hopper</label>

    <description>Stores raw biomass for an adjacent biomass refinery. Build beside any side of a completed refinery and rotate the hopper so its mechanical outlet faces the refinery. Diagonal connections are not supported, and the operator's interaction cell must remain clear.

Colonists haul raw biomass here according to its storage settings. Sealed, refrigerated storage pauses biomass spoilage without requiring power or cooling the room. Existing spoilage is retained when biomass is removed. The refinery combines biomass from all correctly connected hoppers and consumes 40 when a batch starts. Extra hoppers increase storage capacity but do not increase processing speed.</description>

    <thingClass>Building_Storage</thingClass>

    <!-- GeneFoundry Raw Biomass Hopper artwork -->
    <graphicData>
      <texPath>GeneFoundry/Buildings/BiomassHopper</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(1.2,1.2)</drawSize>
      <drawRotated>false</drawRotated>
    </graphicData>
    
    <size>(1,1)</size>
    <rotatable>true</rotatable>

    <placeWorkers>
      <li>GeneFoundry.PlaceWorkers.PlaceWorker_BiomassHopper</li>
    </placeWorkers>

    <!-- Construction -->
    <costList>
      <Steel>30</Steel>
    </costList>

    <statBases>
      <WorkToBuild>500</WorkToBuild>
      <MaxHitPoints>120</MaxHitPoints>
      <Flammability>0.5</Flammability>
    </statBases>

    <useHitPoints>true</useHitPoints>

    <!-- Placement -->
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>42</pathCost>
    <fillPercent>0.5</fillPercent>

    <designationCategory>Biotech</designationCategory>
    <surfaceType>Item</surfaceType>

    <!-- Storage configuration -->
    <building>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>

      <blueprintClass>Blueprint_Storage</blueprintClass>

      <fixedStorageSettings>
        <priority>Important</priority>
        <filter>
          <thingDefs>
            <li>GF_RawBiomass</li>
          </thingDefs>
        </filter>
      </fixedStorageSettings>

      <defaultStorageSettings>
        <priority>Important</priority>
        <filter>
          <thingDefs>
            <li>GF_RawBiomass</li>
          </thingDefs>
        </filter>
      </defaultStorageSettings>

    </building>

    <inspectorTabs>
      <li>ITab_Storage</li>
    </inspectorTabs>

    <tickerType>Never</tickerType>

  </ThingDef>

</Defs>
