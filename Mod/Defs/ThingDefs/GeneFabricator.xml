<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BenchBase">

    <defName>GF_GeneFabricator</defName>
    <label>gene fabricator</label>

    <description>A sophisticated genetic engineering workstation used to manufacture custom genepacks from refined biomass. Requires Crafting 10 and Crafting work assignment. Crafting alone controls speed and operator failure and receives manufacturing XP. Room dirt adds up to 15 percentage points of failure risk at cleanliness -2. Outdoor or unroofed exposure instead adds 10 points. Dim light adds up to 10 further points at darkness, falling to zero at 30% light at the operator interaction cell. Environmental risk is weighted by work performed under each condition.</description>

    <thingClass>GeneFoundry.Fabrication.Building_GeneFabricator</thingClass>
    <tickerType>Rare</tickerType>
    <drawerType>RealtimeOnly</drawerType>
    <inspectorTabs Inherit="False"><li>GeneFoundry.Fabrication.ITab_GeneFabricationBills</li></inspectorTabs>

    <!-- Gene Fabricator artwork -->
    <graphicData>
      <texPath>GeneFoundry/Buildings/GeneFabricator_Detailed</texPath>
      <graphicClass>GeneFoundry.Fabrication.Graphic_GeneFabricator</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(5.4,2.4)</drawSize>
      <drawRotated>false</drawRotated>
    </graphicData>

    <!-- Building dimensions -->
    <size>(5,2)</size>
    <rotatable>true</rotatable>

    <!-- Research -->
    <researchPrerequisites>
      <li>GF_GeneFabrication</li>
    </researchPrerequisites>

    <!-- Construction -->
    <costList>
      <Steel>250</Steel>
      <ComponentIndustrial>8</ComponentIndustrial>
      <Plasteel>50</Plasteel>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>

    <statBases>
      <WorkToBuild>5000</WorkToBuild>
      <MaxHitPoints>250</MaxHitPoints>
      <Flammability>0.4</Flammability>
    </statBases>

    <useHitPoints>true</useHitPoints>

    <!-- Placement -->
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>

    <designationCategory>Biotech</designationCategory>

    <!-- Colonist interaction -->
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>

    <surfaceType>Item</surfaceType>

    <placeWorkers Inherit="False" />
    <comps Inherit="False">
      <li Class="CompProperties_Power"><compClass>CompPowerTrader</compClass><basePowerConsumption>500</basePowerConsumption><shortCircuitInRain>true</shortCircuitInRain></li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
    </comps>
    <building>
      <workTableRoomRole>Laboratory</workTableRoomRole>
    </building>

  </ThingDef>

</Defs>
