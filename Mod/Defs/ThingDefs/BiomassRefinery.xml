<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">

    <defName>GF_BiomassRefinery</defName>
    <researchPrerequisites>
      <li>GF_GeneFabrication</li>
    </researchPrerequisites>
    <label>biomass refinery</label>

    <description>Refine 45 raw biomass from correctly oriented adjacent hoppers and 1 delivered neutroamine into exactly 10 refined biomass on success. Failure consumes all inputs. Requires Intellectual 5, Crafting 3 and Medicine 2. Weighted skill (60/25/15), clamped to 5-20, linearly reduces preparation from 90 to 30 minutes. Operator failure interpolates from 30% at weighted skill 5 to 5% at 10, then 0% at 20. Dirt adds up to 15 percentage points at cleanliness -2; cleanliness 0 or above gives no adjustment. Outdoor or unroofed exposure instead adds 10 points. Dim light adds up to 10 further points at darkness, falling to zero at 30% light at the interaction cell. Final risk is captured at batch start and rolled once at completion. Automated processing defaults to 360 minutes (6 hours), reduced by 20 minutes per available gene processor to a minimum of 60 minutes (1 hour), reached with 15 processors. Processor allocation, power pausing and spoilage after two continuous hours without power apply. Processing duration and assistance are configurable.</description>

    <thingClass>Building_WorkTable</thingClass>
    <drawerType>RealtimeOnly</drawerType>
    <tickerType>Normal</tickerType>
    <category>Building</category>

    <!-- GeneFoundry Biomass Refinery artwork -->
    <graphicData>
      <texPath>GeneFoundry/Buildings/BiomassRefinery</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3.2,2.2)</drawSize>
      <drawRotated>false</drawRotated>
    </graphicData>
    
    <size>(3,2)</size>
    <rotatable>true</rotatable>

    <costList>
      <Steel>200</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
    </costList>

    <statBases>
      <WorkToBuild>4500</WorkToBuild>
      <MaxHitPoints>250</MaxHitPoints>
      <Flammability>0.4</Flammability>
    </statBases>

    <useHitPoints>true</useHitPoints>

    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>

    <designationCategory>Biotech</designationCategory>

    <!-- Colonist interaction -->
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(-1,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>

    <!-- Production bills -->
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>

    <!-- Available production recipes -->
    <recipes>
      <li>GF_StartBiomassRefinement</li>
    </recipes>

    <!-- Electrical components -->
    <comps>

      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>100</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>

      <li Class="CompProperties_Flickable" />

      <li Class="CompProperties_Breakdownable" />

      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>GeneProcessor</li>
        </linkableFacilities>
      </li>

      <!-- Automated biomass refinement -->
      <li Class="GeneFoundry.Components.CompProperties_BiomassRefiner">

        <inputDef>GF_RawBiomass</inputDef>
        <outputDef>GF_RefinedBiomass</outputDef>

        <inputCount>45</inputCount>
        <outputCount>10</outputCount>

        <!-- Legacy duration for migrating pre-settings saves only. Runtime timings use Mod Settings. -->
        <processingTicks>2500</processingTicks>

        <idlePower>100</idlePower>
        <activePower>1000</activePower>

      </li>

    </comps>

  </ThingDef>

</Defs>
